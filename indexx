<!DOCTYPE html>
<html>
<head>
  <title>Tes Jalur Cepat</title>
</head>
<body style="padding: 50px; font-family: Arial, sans-serif;">

  <h2>Tes Jalur Cepat ke Database</h2>
  <button onclick="tesLangsung()" style="padding: 15px; font-size: 16px; background: blue; color: white;">Hubungkan ke Database</button>
  
  <p id="hasil" style="margin-top: 20px; font-weight: bold; color: #333;"></p>

  <script>
    function tesLangsung() {
      const teksHasil = document.getElementById('hasil');
      teksHasil.innerText = "Mencoba menghubungi Supabase...";
      
      const url = 'https://nffrxxkydlsvtbliqalv.supabase.co/rest/v1/app_users?select=*';
      const key = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5mZnJ4eGt5ZGxzdnRibGlxYWx2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg4MzI1NTcsImV4cCI6MjEwNDQwODU1N30.s5YBFQ7W1KRKba3MMRFl-q42nRRApak_3QLd7S4B85A';
      
      fetch(url, {
        method: 'GET',
        headers: {
          'apikey': key,
          'Authorization': 'Bearer ' + key,
          'Content-Type': 'application/json'
        }
      })
      .then(response => {
        if (!response.ok) {
          throw new Error("Ditolak Supabase. Status: " + response.status);
        }
        return response.json();
      })
      .then(data => {
        if(data.length === 0) {
          teksHasil.innerText = "Koneksi BERHASIL! Tapi tabel app_users KOSONG. Anda belum memasukkan data admin.";
        } else {
          teksHasil.innerText = "Koneksi BERHASIL! Data ditemukan: " + JSON.stringify(data);
        }
      })
      .catch(error => {
        teksHasil.innerText = "ERROR JARINGAN/SISTEM: " + error.message;
      });
    }
  </script>
</body>
</html>
